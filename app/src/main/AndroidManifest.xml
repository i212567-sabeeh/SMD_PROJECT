<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LeagueX"
        tools:targetApi="37">

        <!-- LeagueX screens: the list of every Figma frame, and where the app opens. -->
        <activity
            android:name=".screens.ScreenListActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Figma's Style kit page, opened from the last row of the screen list. -->
        <activity
            android:name=".screens.StyleKitActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden" />

        <!-- Getting started (01–07). -->
        <activity
            android:name=".start.SplashActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".start.WelcomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".start.SignUpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".start.LogInActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".start.ForgotPasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".start.GetStartedActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".start.SetUpProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Home (08). -->
        <activity
            android:name=".home.HomeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- League, matches and standings (12–17); 09 is a sheet over Home. -->
        <activity
            android:name=".league.LeagueActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".league.MatchesActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name=".league.MatchActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".league.StandingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- Teams, players and news (10, 18–23); 11 is a sheet over Search. -->
        <activity
            android:name=".news.SearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name=".news.TeamsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name=".news.TeamActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".news.PlayerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".news.AnnouncementsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".news.AnnouncementActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".news.NotificationsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Players (24–27); 53 Pick is a sheet over Edit profile. -->
        <activity
            android:name=".players.ProfileActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name=".players.EditProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".players.JoinTeamActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".players.TeamInviteActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Captains (28–31). -->
        <activity
            android:name=".captains.RegisterTeamActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".captains.ManageSquadActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".captains.AddPlayersActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".captains.EditTeamActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Organizers: setting up (32–44); 41 is a sheet over the dashboard. -->
        <activity
            android:name=".organizer.CreateTypeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".organizer.CreateDetailsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".organizer.CreateRulesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".organizer.CreateReviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".organizer.PublishedActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".organizer.DashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".organizer.TeamRequestsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".organizer.FixturesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".organizer.DrawActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".organizer.StartPlayoffsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".organizer.PostAnnouncementActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".organizer.LeagueSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
