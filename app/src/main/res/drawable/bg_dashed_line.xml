<?xml version="1.0" encoding="utf-8"?>
<!-- A 2dp dashed blue line: the playoff line under a table row, and its legend. Give the view a 2dp height. It's the
     top edge of a dashed rectangle whose other edges sit outside the view, which every renderer draws. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="-4dp"
        android:left="-4dp"
        android:right="-4dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/blue"
                android:dashGap="3dp"
                android:dashWidth="5dp" />
        </shape>
    </item>
</layer-list>
