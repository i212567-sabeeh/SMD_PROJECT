<?xml version="1.0" encoding="utf-8"?>
<!-- .crest.ring: the crest inside a 3dp paper ring. crest() tints the inner circle (crest_fill). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/paper" />
        </shape>
    </item>
    <item
        android:id="@+id/crest_fill"
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</layer-list>
