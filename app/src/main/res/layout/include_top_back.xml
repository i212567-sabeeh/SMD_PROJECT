<!-- Figma: Style kit, Top bars (Edit profile). A pushed screen's bar: back, the title and an optional action (ui.js topBack). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/top_bar_height"
    android:divider="@drawable/gap_4"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="8dp"
    android:showDividers="middle">

    <!-- arrow_back; the create flow sets ic_close. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/back"
        style="@style/Widget.LeagueX.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/kit_cd_back"
        app:icon="@drawable/ic_arrow_back" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.LeagueX.Title.Large"
        tools:targetApi="28"
        tools:text="Edit profile" />

    <!-- An icon action such as more_vert, share or settings. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        style="@style/Widget.LeagueX.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:icon="@drawable/ic_more_vert"
        tools:visibility="visible" />

    <!-- Or a text action such as "Skip". -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/actionText"
        style="@style/Widget.LeagueX.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
