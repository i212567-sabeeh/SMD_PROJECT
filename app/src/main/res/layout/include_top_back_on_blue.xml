<!-- Figma: 14 Match page, 46 Record match, 50 Penalty shootout and the team and player pages: the back bar on the blue block (ui.js topBack onBlue). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/top_bar_height"
    android:divider="@drawable/gap_4"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="8dp"
    android:showDividers="middle">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/back"
        style="@style/Widget.LeagueX.IconButton.PlainOnBlue"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/kit_cd_back"
        app:icon="@drawable/ic_arrow_back" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.LeagueX.Title.Large"
        android:textColor="@color/on_blue"
        tools:targetApi="28"
        tools:text="Matchday 5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        style="@style/Widget.LeagueX.IconButton.PlainOnBlue"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:icon="@drawable/ic_share"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/actionText"
        style="@style/Widget.LeagueX.Button.OnBlueOutlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
