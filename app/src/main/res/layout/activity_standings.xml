<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 15 Table, 16 Bracket and 17 Stats. A league's tabs are Table, Playoffs and Stats; a knockout's are Bracket
     and Stats. The undrawn Playoffs tab shows an empty state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/blueBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_blue_block"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <include
            android:id="@+id/top"
            layout="@layout/include_top_tab" />

        <include
            android:id="@+id/league"
            layout="@layout/include_league_row" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            style="@style/Widget.LeagueX.Tabs.OnBlue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 15 Table: the whole table, full width. -->
            <LinearLayout
                android:id="@+id/tableArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/paper"
                    tools:itemCount="9"
                    tools:listitem="@layout/item_table_row" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:showDividers="middle">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="2dp"
                        android:background="@drawable/bg_dashed_line" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/standings_top_four"
                        android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                        android:textColor="@color/muted" />
                </LinearLayout>
            </LinearLayout>

            <!-- The league's Playoffs tab, before the playoffs start. -->
            <include
                android:id="@+id/playoffs"
                layout="@layout/include_empty_state"
                android:visibility="gone" />

            <!-- 16 Bracket: three rounds across the phone, narrow ties joined by short lines. -->
            <LinearLayout
                android:id="@+id/bracketArea"
                style="@style/Widget.LeagueX.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <FrameLayout
                        android:layout_width="372dp"
                        android:layout_height="wrap_content"
                        android:minHeight="440dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/standings_quarters"
                            android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                            android:textColor="@color/muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="131dp"
                            android:text="@string/standings_semis"
                            android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                            android:textColor="@color/muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="262dp"
                            android:text="@string/standings_final"
                            android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                            android:textColor="@color/muted" />

                        <!-- Connectors: quarter-finals to semi-finals, then semi-finals to the final. -->
                        <View android:layout_width="10dp" android:layout_height="2dp" android:layout_marginStart="110dp" android:layout_marginTop="84dp" android:background="@color/line" />
                        <View android:layout_width="10dp" android:layout_height="2dp" android:layout_marginStart="110dp" android:layout_marginTop="188dp" android:background="@color/line" />
                        <View android:layout_width="2dp" android:layout_height="106dp" android:layout_marginStart="120dp" android:layout_marginTop="84dp" android:background="@color/line" />
                        <View android:layout_width="11dp" android:layout_height="2dp" android:layout_marginStart="120dp" android:layout_marginTop="136dp" android:background="@color/line" />
                        <View android:layout_width="10dp" android:layout_height="2dp" android:layout_marginStart="110dp" android:layout_marginTop="292dp" android:background="@color/line" />
                        <View android:layout_width="10dp" android:layout_height="2dp" android:layout_marginStart="110dp" android:layout_marginTop="396dp" android:background="@color/line" />
                        <View android:layout_width="2dp" android:layout_height="106dp" android:layout_marginStart="120dp" android:layout_marginTop="292dp" android:background="@color/line" />
                        <View android:layout_width="11dp" android:layout_height="2dp" android:layout_marginStart="120dp" android:layout_marginTop="344dp" android:background="@color/line" />
                        <View android:layout_width="10dp" android:layout_height="2dp" android:layout_marginStart="241dp" android:layout_marginTop="136dp" android:background="@color/line" />
                        <View android:layout_width="10dp" android:layout_height="2dp" android:layout_marginStart="241dp" android:layout_marginTop="344dp" android:background="@color/line" />
                        <View android:layout_width="2dp" android:layout_height="210dp" android:layout_marginStart="251dp" android:layout_marginTop="136dp" android:background="@color/line" />
                        <View android:layout_width="11dp" android:layout_height="2dp" android:layout_marginStart="251dp" android:layout_marginTop="240dp" android:background="@color/line" />

                        <include android:id="@+id/qf1" layout="@layout/include_tie" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="40dp" />
                        <include android:id="@+id/qf2" layout="@layout/include_tie" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="144dp" />
                        <include android:id="@+id/qf3" layout="@layout/include_tie" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="248dp" />
                        <include android:id="@+id/qf4" layout="@layout/include_tie" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="352dp" />
                        <include android:id="@+id/sf1" layout="@layout/include_tie" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="131dp" android:layout_marginTop="92dp" />
                        <include android:id="@+id/sf2" layout="@layout/include_tie" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="131dp" android:layout_marginTop="300dp" />
                        <include android:id="@+id/finalTie" layout="@layout/include_tie" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="262dp" android:layout_marginTop="196dp" />
                    </FrameLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/bracketNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                    android:textColor="@color/muted"
                    tools:text="Penalty wins are shown under each tie. The final is on Sat 29 Nov, 7:00 pm." />
            </LinearLayout>

            <!-- 17 Stats: the leaders in goals, assists and cards. -->
            <LinearLayout
                android:id="@+id/statsArea"
                style="@style/Widget.LeagueX.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_16"
                android:paddingTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/goalsHead"
                        layout="@layout/include_section_head" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/goals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_player_row" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/assistsHead"
                        layout="@layout/include_section_head" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/assists"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_player_row" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/cardsHead"
                        layout="@layout/include_section_head" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/cards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_player_row" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav" />
</LinearLayout>
