<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 19 Team page, 19 Team page / Captain, and 57 Loading / Images. The team's crest, captain and competitions
     on the blue block (the captain also gets Manage squad and Edit team), then the squad and recent results. While
     photos load, the crest and avatars are grey circles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/blueBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_blue_block"
                android:orientation="vertical">

                <include
                    android:id="@+id/top"
                    layout="@layout/include_top_back_on_blue" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/crest"
                        style="@style/Widget.LeagueX.Crest.XL.Ring"
                        tools:text="MAR" />

                    <View
                        android:id="@+id/crestLoading"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_glyph_circle"
                        android:backgroundTint="@color/on_blue_surface"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.LeagueX.Title.Large"
                        android:textColor="@color/on_blue"
                        tools:text="Margalla Strikers" />

                    <TextView
                        android:id="@+id/about"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
                        android:textColor="@color/on_blue_muted"
                        tools:text="Captain: Hamza Ali, Islamabad" />

                    <LinearLayout
                        android:id="@+id/competitions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/gap_8"
                        android:orientation="horizontal"
                        android:showDividers="middle">

                        <TextView
                            android:id="@+id/league"
                            style="@style/Widget.LeagueX.Status.OnBlue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Islamabad Futsal League" />

                        <TextView
                            android:id="@+id/cup"
                            style="@style/Widget.LeagueX.Status.OnBlue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Capital Futsal Cup" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/captainActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:divider="@drawable/gap_12"
                        android:orientation="horizontal"
                        android:showDividers="middle"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/manageSquad"
                            style="@style/Widget.LeagueX.Button.OnBlue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/team_manage_squad"
                            app:icon="@drawable/ic_group" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editTeam"
                            style="@style/Widget.LeagueX.Button.OnBlueOutlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/team_edit"
                            app:icon="@drawable/ic_edit" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content"
                style="@style/Widget.LeagueX.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_20"
                android:paddingTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_12"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/squadHead"
                        layout="@layout/include_section_head" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/squad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_player_row" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/resultsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_12"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/resultsHead"
                        layout="@layout/include_section_head" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_result_row" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
