<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 24 My profile, and 24 My profile / Organizer. The avatar, name and role on the blue block with Edit
     profile; a player sees their numbers, teams and matches, an organizer the competitions they run and follow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/blueBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_blue_block"
                android:orientation="vertical">

                <include
                    android:id="@+id/top"
                    layout="@layout/include_top_tab" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/avatar"
                        style="@style/Widget.LeagueX.Avatar.XL"
                        tools:text="UT" />

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LeagueX.Title.Large"
                        android:textColor="@color/on_blue"
                        tools:text="Usman Tariq" />

                    <TextView
                        android:id="@+id/role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
                        android:textColor="@color/on_blue_muted"
                        tools:text="Winger, #7" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/edit"
                        style="@style/Widget.LeagueX.Button.OnBlueOutlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/profile_edit"
                        app:icon="@drawable/ic_edit" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content"
                style="@style/Widget.LeagueX.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_20"
                android:paddingTop="20dp">

                <!-- A player's season. -->
                <LinearLayout
                    android:id="@+id/stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_2"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <TextView
                            android:id="@+id/played"
                            style="@style/Widget.LeagueX.Anton.Stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/player_played"
                            android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                            android:textColor="@color/muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_2"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <TextView
                            android:id="@+id/goals"
                            style="@style/Widget.LeagueX.Anton.Stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/player_goals"
                            android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                            android:textColor="@color/muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_2"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <TextView
                            android:id="@+id/assists"
                            style="@style/Widget.LeagueX.Anton.Stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_assists"
                            android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                            android:textColor="@color/muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_2"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <TextView
                            android:id="@+id/cards"
                            style="@style/Widget.LeagueX.Anton.Stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/player_cards"
                            android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                            android:textColor="@color/muted" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/teamsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_12"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/teamsHead"
                        layout="@layout/include_section_head" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/teams"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        tools:itemCount="1"
                        tools:listitem="@layout/item_team_row" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/historySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_12"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/historyHead"
                        layout="@layout/include_section_head" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_result_row" />
                </LinearLayout>

                <!-- An organizer's competitions. -->
                <LinearLayout
                    android:id="@+id/runSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_12"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:visibility="gone">

                    <include
                        android:id="@+id/runHead"
                        layout="@layout/include_section_head" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/run"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_action_row" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/create"
                        style="@style/Widget.LeagueX.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_create"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/followSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_12"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:visibility="gone">

                    <include
                        android:id="@+id/followHead"
                        layout="@layout/include_section_head" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/follow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        tools:itemCount="1"
                        tools:listitem="@layout/item_action_row" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav" />
</LinearLayout>
