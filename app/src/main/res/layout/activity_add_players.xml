<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 30 Add players. Players with no team yet, filtered, each with Invite; and the team's invite code to share. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            style="@style/Widget.LeagueX.Content.Tight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.LeagueX.Search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/add_search_hint"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.LeagueX.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/position_forward" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/city"
                    style="@style/Widget.LeagueX.Chip.Filter.Dropdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    tools:text="Islamabad" />
            </com.google.android.material.chip.ChipGroup>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/players"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                tools:itemCount="3"
                tools:listitem="@layout/item_player_row" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:divider="@drawable/gap_12"
                android:orientation="vertical"
                android:padding="20dp"
                android:showDividers="middle">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_share_title"
                    android:textAppearance="@style/TextAppearance.LeagueX.Title.Small" />

                <TextView
                    android:id="@+id/shareBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
                    android:textColor="@color/muted"
                    tools:text="Anyone with this code can ask to join Margalla Strikers." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/code"
                        style="@style/Widget.LeagueX.Anton.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="MAR-4821" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copy"
                        style="@style/Widget.LeagueX.IconButton.Tonal"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/add_cd_copy"
                        app:icon="@drawable/ic_content_copy" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/share"
                    style="@style/Widget.LeagueX.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_share"
                    app:icon="@drawable/ic_share" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
