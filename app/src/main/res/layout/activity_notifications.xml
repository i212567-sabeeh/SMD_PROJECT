<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 23 Notifications. New ones first, tinted with a blue dot, then earlier ones; Mark all read in the top bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            style="@style/Widget.LeagueX.Content.Tight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notes_new"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                android:textColor="@color/muted" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                tools:itemCount="2"
                tools:listitem="@layout/item_note_row" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notes_earlier"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                android:textColor="@color/muted" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/earlier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                tools:itemCount="2"
                tools:listitem="@layout/item_note_row" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
