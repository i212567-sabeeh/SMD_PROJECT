<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 17 Stats, 19 Team page, 26 Join a team, 29 Manage squad, 30 Add players, 45 Line-ups and the Style kit's
     player rows (ui.js playerRow). An optional shirt number, the avatar, name and meta, then one trailing part. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.LeagueX.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/number"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.LeagueX.Display.Small"
        android:textColor="@color/muted"
        android:visibility="gone"
        tools:text="11"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/avatar"
        style="@style/Widget.LeagueX.Avatar.M"
        tools:text="MA" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:divider="@drawable/gap_2"
        android:orientation="vertical"
        android:showDividers="middle">

        <TextView
            android:id="@+id/name"
            style="@style/Widget.LeagueX.Row.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Muhammad Abdullah Qureshi" />

        <TextView
            android:id="@+id/meta"
            style="@style/Widget.LeagueX.Row.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Forward, #11" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_4"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:showDividers="middle">

        <ImageView
            android:id="@+id/chevron"
            style="@style/Widget.LeagueX.Row.Icon"
            android:src="@drawable/ic_chevron_right"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/stat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LeagueX.Display.Small"
            android:visibility="gone"
            tools:text="6" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check"
            style="@style/Widget.LeagueX.CheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/invite"
            style="@style/Widget.LeagueX.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/row_invite"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pending"
            style="@style/Widget.LeagueX.Status.Waiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/row_invite_sent"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call"
            style="@style/Widget.LeagueX.IconButton.Tonal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/row_cd_call"
            android:visibility="gone"
            app:icon="@drawable/ic_call" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/more"
            style="@style/Widget.LeagueX.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/row_cd_more"
            android:visibility="gone"
            app:icon="@drawable/ic_more_vert" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remove"
            style="@style/Widget.LeagueX.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/row_cd_remove"
            android:visibility="gone"
            app:icon="@drawable/ic_person_remove" />

        <!-- Bookings on 17 Stats: a yellow card and its count, then a red one when there is one. -->
        <LinearLayout
            android:id="@+id/cards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:layout_width="12dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_card_mark"
                android:backgroundTint="@color/card_yellow" />

            <TextView
                android:id="@+id/yellow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/row_cd_yellow"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                tools:text="2" />

            <View
                android:id="@+id/redMark"
                android:layout_width="12dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_card_mark"
                android:backgroundTint="@color/card_red" />

            <TextView
                android:id="@+id/red"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/row_cd_red"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                tools:text="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
