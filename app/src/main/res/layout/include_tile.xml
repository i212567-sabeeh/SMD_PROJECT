<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 37 Organizer dashboard's shortcut tiles: a glyph in a tint circle over its label, on a card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:divider="@drawable/gap_8"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    android:showDividers="middle">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_glyph_circle"
        android:importantForAccessibility="no"
        android:padding="10dp"
        app:tint="@color/blue"
        tools:src="@drawable/ic_calendar_month" />

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
        tools:text="Generate fixtures" />
</LinearLayout>
