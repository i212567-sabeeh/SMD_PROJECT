<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: the cards with a glyph, a title and a line under it, such as 14's venue, 12's announcement and 14 Organizer's
     "Line-ups not set yet" (card pad row-x gap-12). Bind it with IncludeInfoCardBinding.bind(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:divider="@drawable/gap_12"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    android:showDividers="middle">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_glyph_circle"
        android:importantForAccessibility="no"
        android:padding="10dp"
        app:tint="@color/blue"
        tools:src="@drawable/ic_location_on" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:divider="@drawable/gap_2"
        android:orientation="vertical"
        android:showDividers="middle">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
            tools:text="F-9 Sports Arena, Court 2" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
            android:textColor="@color/muted"
            tools:text="Sat 15 Nov, 7:00 pm" />
    </LinearLayout>

    <ImageView
        android:id="@+id/chevron"
        style="@style/Widget.LeagueX.Row.Icon"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone" />
</LinearLayout>
