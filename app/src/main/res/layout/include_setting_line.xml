<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: a setting with a switch, such as 34's Playoffs and Extra time, 41's Notify both teams and 43's Send push
     notification (organizer-setup.js settingLine). Bind it with IncludeSettingLineBinding.bind(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/gap_12"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:showDividers="middle">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:divider="@drawable/gap_2"
        android:orientation="vertical"
        android:showDividers="middle">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LeagueX.Title.Small"
            tools:text="Playoffs" />

        <TextView
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
            android:textColor="@color/muted"
            tools:text="Top teams play knockouts after the league games." />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/toggle"
        style="@style/Widget.LeagueX.Switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
