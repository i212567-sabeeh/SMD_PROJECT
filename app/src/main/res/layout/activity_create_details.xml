<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 33 Create / Details. Step 2 of 4: name, season, banner, where it's played, then Continue. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <include
        android:id="@+id/steps"
        layout="@layout/include_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Widget.LeagueX.Content.Form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_16">

            <LinearLayout
                style="@style/Widget.LeagueX.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/name"
                    android:text="@string/details_name"
                    android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LeagueX.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        tools:text="Islamabad Futsal League" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.LeagueX.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/season"
                    android:text="@string/details_season"
                    android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LeagueX.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/season"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        tools:text="2026" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.LeagueX.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/details_banner"
                    android:textAppearance="@style/TextAppearance.LeagueX.Label.Large" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp">

                    <include
                        android:id="@+id/banner"
                        layout="@layout/include_banner"
                        android:layout_width="match_parent"
                        android:layout_height="100dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeBanner"
                        style="@style/Widget.LeagueX.Button.OnBlue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:text="@string/details_change_banner"
                        app:icon="@drawable/ic_image" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.LeagueX.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/province"
                    android:text="@string/start_province"
                    android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LeagueX.TextField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/province"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        app:simpleItems="@array/provinces" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.LeagueX.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/city"
                    android:text="@string/start_city"
                    android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LeagueX.TextField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/city"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        app:simpleItems="@array/cities" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.LeagueX.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/venue"
                    android:text="@string/details_venue"
                    android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LeagueX.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/venue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        tools:text="F-9 Sports Arena" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/footer"
        style="@style/Widget.LeagueX.Footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next"
            style="@style/Widget.LeagueX.Button.Filled.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_continue" />
    </LinearLayout>
</LinearLayout>
