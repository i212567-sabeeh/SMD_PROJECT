<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 52 Sync status and 57 Error / Upload failed. What's saved on this phone and its upload: a summary card, the
     changes waiting (or uploaded), the failed upload, and Sync now (or Retry upload). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <include
        android:id="@+id/offline"
        layout="@layout/include_offline_banner"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            style="@style/Widget.LeagueX.Content.Tight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp">

            <LinearLayout
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:divider="@drawable/gap_12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:showDividers="middle">

                <ImageView
                    android:id="@+id/summaryGlyph"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_glyph_circle"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_cloud_sync"
                    app:tint="@color/blue" />

                <ImageView
                    android:id="@+id/summaryIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_error"
                    android:visibility="gone"
                    app:tint="@color/error" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:divider="@drawable/gap_2"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/summaryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LeagueX.Title.Small"
                        tools:text="Last synced 7:41 pm" />

                    <TextView
                        android:id="@+id/summaryBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                        android:textColor="@color/muted"
                        tools:text="3 changes are waiting for a connection" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/itemsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                android:textColor="@color/muted"
                tools:text="Waiting" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                tools:itemCount="3"
                tools:listitem="@layout/item_sync" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sync_failed"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                android:textColor="@color/muted" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/failedItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                tools:itemCount="1"
                tools:listitem="@layout/item_sync" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/footer"
        style="@style/Widget.LeagueX.Footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sync"
            style="@style/Widget.LeagueX.Button.Filled.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_now"
            app:icon="@drawable/ic_sync" />
    </LinearLayout>
</LinearLayout>
