<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 34 Create / Rules, league, and 34 Create / Rules, tournament. Step 3 of 4: a league's fixtures, points and
     playoffs, or a knockout's extra time and third-place match; both set the match length. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <include
        android:id="@+id/steps"
        layout="@layout/include_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Widget.LeagueX.Content.Form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_16">

            <!-- League. -->
            <LinearLayout
                android:id="@+id/playEach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_4"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rules_play_each"
                    android:textAppearance="@style/TextAppearance.LeagueX.Label.Large" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/once"
                        style="@style/Widget.LeagueX.RadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="@string/rules_once"
                        android:textAppearance="@style/TextAppearance.LeagueX.Body.Large" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/homeAway"
                        style="@style/Widget.LeagueX.RadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/rules_home_away"
                        android:textAppearance="@style/TextAppearance.LeagueX.Body.Large" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:divider="@drawable/gap_12"
                android:orientation="horizontal"
                android:showDividers="middle">

                <LinearLayout
                    style="@style/Widget.LeagueX.Field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/win"
                        android:text="@string/rules_win"
                        android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LeagueX.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/win"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            tools:text="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.LeagueX.Field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/draw"
                        android:text="@string/rules_draw"
                        android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LeagueX.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/draw"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            tools:text="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.LeagueX.Field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/loss"
                        android:text="@string/rules_loss"
                        android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LeagueX.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/loss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            tools:text="0" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/playoffsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:divider="@drawable/gap_12"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:showDividers="middle">

                <include
                    android:id="@+id/playoffs"
                    layout="@layout/include_setting_line" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.LeagueX.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rules_top_2" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.LeagueX.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/rules_top_4" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.LeagueX.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rules_top_8" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <!-- Tournament. -->
            <LinearLayout
                android:id="@+id/extraTimeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:divider="@drawable/gap_12"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:showDividers="middle"
                android:visibility="gone">

                <include
                    android:id="@+id/extraTime"
                    layout="@layout/include_setting_line" />

                <LinearLayout
                    style="@style/Widget.LeagueX.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/extraLength"
                        android:text="@string/rules_extra_time_length"
                        android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LeagueX.TextField.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/extraLength"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/extra_time_lengths" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/penaltiesNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tinted"
                android:divider="@drawable/gap_12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:showDividers="middle"
                android:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sports_soccer"
                    app:tint="@color/blue" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rules_penalties"
                    android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/thirdPlaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <include
                    android:id="@+id/thirdPlace"
                    layout="@layout/include_setting_line" />
            </LinearLayout>

            <!-- Both. -->
            <LinearLayout
                style="@style/Widget.LeagueX.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/matchLength"
                    android:text="@string/rules_match_length"
                    android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LeagueX.TextField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/matchLength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        app:simpleItems="@array/match_lengths" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/footer"
        style="@style/Widget.LeagueX.Footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next"
            style="@style/Widget.LeagueX.Button.Filled.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_continue" />
    </LinearLayout>
</LinearLayout>
