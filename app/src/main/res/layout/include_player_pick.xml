<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 47–49's player fields, such as "Scorer": a dropdown of the chosen team's players. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.LeagueX.Field"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@+id/dropdown"
        android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel"
        tools:text="Scorer" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.LeagueX.TextField.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/event_pick_player"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
