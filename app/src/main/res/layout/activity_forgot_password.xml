<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 05 Forgot password, and 05 Forgot password / Check your email. FORM asks for the email; CHECK_EMAIL shows
     the sent state in the middle, with Back to log in and Send again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Widget.LeagueX.Content.Form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/start_reset_body"
                android:textAppearance="@style/TextAppearance.LeagueX.Body.Large" />

            <LinearLayout
                style="@style/Widget.LeagueX.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/email"
                    android:text="@string/start_email"
                    android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LeagueX.TextField.Focused"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        tools:text="usman.tariq@example.com" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/sent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/page_margin"
        android:visibility="gone"
        tools:visibility="visible">

        <include
            android:id="@+id/empty"
            layout="@layout/include_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/footer"
        style="@style/Widget.LeagueX.Footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendLink"
            style="@style/Widget.LeagueX.Button.Filled.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_send_link" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToLogIn"
            style="@style/Widget.LeagueX.Button.Filled.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_back_to_log_in"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sendAgainRow"
            style="@style/Widget.LeagueX.FooterLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_didnt_get"
                android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
                android:textColor="@color/muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendAgain"
                style="@style/Widget.LeagueX.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="@string/start_send_again" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
