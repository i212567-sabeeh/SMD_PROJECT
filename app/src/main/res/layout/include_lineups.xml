<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 14 Match page / Before kick-off: both teams' line-ups side by side on a card. Bind it with
     IncludeLineupsBinding.bind(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:baselineAligned="false"
    android:divider="@drawable/gap_16"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    android:showDividers="middle">

    <LinearLayout
        android:id="@+id/home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:divider="@drawable/gap_8"
        android:orientation="vertical"
        android:showDividers="middle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:showDividers="middle">

            <TextView
                android:id="@+id/homeCrest"
                style="@style/Widget.LeagueX.Crest.S"
                tools:text="MAR" />

            <TextView
                android:id="@+id/homeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                tools:text="Margalla Strikers" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/away"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:divider="@drawable/gap_8"
        android:orientation="vertical"
        android:showDividers="middle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:showDividers="middle">

            <TextView
                android:id="@+id/awayCrest"
                style="@style/Widget.LeagueX.Crest.S"
                tools:text="RAW" />

            <TextView
                android:id="@+id/awayName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                tools:text="Rawal Rovers" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
