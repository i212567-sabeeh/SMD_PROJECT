<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 53 Photo upload / Pick, a sheet over 25 Edit profile: take a photo, choose one, or remove it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/head"
        layout="@layout/include_sheet_head" />

    <LinearLayout
        style="@style/Widget.LeagueX.SheetBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:showDividers="none">

        <include
            android:id="@+id/take"
            layout="@layout/item_sheet_action" />

        <include
            android:id="@+id/gallery"
            layout="@layout/item_sheet_action" />

        <include
            android:id="@+id/remove"
            layout="@layout/item_sheet_action" />
    </LinearLayout>
</LinearLayout>
