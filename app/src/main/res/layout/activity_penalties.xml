<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 50 Penalty shootout. The shootout score on the blue block, each team's kicks so far, and the next kick to
     record as scored or missed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/blueBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_blue_block"
        android:orientation="vertical">

        <include
            android:id="@+id/top"
            layout="@layout/include_top_back_on_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_8"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/homeCrest"
                        style="@style/Widget.LeagueX.Crest.M.Ring"
                        tools:text="MAR" />

                    <TextView
                        android:id="@+id/homeCode"
                        style="@style/Widget.LeagueX.Anton.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_blue"
                        tools:text="MAR" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/score"
                    style="@style/Widget.LeagueX.Anton.Score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_blue"
                    tools:text="4–3" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/awayCode"
                        style="@style/Widget.LeagueX.Anton.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_blue"
                        tools:text="CAP" />

                    <TextView
                        android:id="@+id/awayCrest"
                        style="@style/Widget.LeagueX.Crest.M.Ring"
                        tools:text="CAP" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shootout_about"
                android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
                android:textColor="@color/on_blue_muted" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            style="@style/Widget.LeagueX.Content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_20"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:divider="@drawable/gap_12"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:showDividers="middle">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shootout_kicks"
                    android:textAppearance="@style/TextAppearance.LeagueX.Title.Small" />

                <include
                    android:id="@+id/kicksHome"
                    layout="@layout/include_kicks_row" />

                <include
                    android:id="@+id/kicksAway"
                    layout="@layout/include_kicks_row" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:divider="@drawable/gap_16"
                android:orientation="vertical"
                android:padding="20dp"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_4"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LeagueX.Title.Medium"
                        tools:text="Capital United, 5th kick" />

                    <TextView
                        android:id="@+id/stakes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
                        android:textColor="@color/muted"
                        tools:text="If they miss, Margalla Strikers win." />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/kickButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_12"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scored"
                        style="@style/Widget.LeagueX.Button.Filled.Big"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/shootout_scored"
                        app:icon="@drawable/ic_check" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/missed"
                        style="@style/Widget.LeagueX.Button.Danger.Big"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/shootout_missed"
                        app:icon="@drawable/ic_close" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/finish"
                    style="@style/Widget.LeagueX.Button.Filled.Big"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_finish"
                    android:visibility="gone"
                    app:icon="@drawable/ic_sports_score" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/undo"
                    style="@style/Widget.LeagueX.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/shootout_undo"
                    app:icon="@drawable/ic_undo" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
