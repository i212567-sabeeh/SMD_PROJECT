<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 47–49's "Minute", filled in from the match clock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.LeagueX.Field"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@+id/value"
        android:text="@string/event_minute"
        android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.LeagueX.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:endIconDrawable="@drawable/ic_timer"
        app:endIconMode="custom">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            tools:text="33'" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Widget.LeagueX.FieldHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/event_minute_help" />
</LinearLayout>
