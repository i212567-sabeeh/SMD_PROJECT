<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 28 Register a team, and 28 Register a team / Waiting for approval. Which team, the competition's join code
     and what it is, then Send request; once sent, the request waits for the organizer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Widget.LeagueX.Content.Form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_which"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"
                android:divider="@drawable/gap_12"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:id="@+id/useYours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_option_card"
                    android:divider="@drawable/gap_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:showDividers="middle">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/useYoursRadio"
                        style="@style/Widget.LeagueX.RadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/useYoursCrest"
                        style="@style/Widget.LeagueX.Crest.M"
                        tools:text="MAR" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_2"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/register_use_yours"
                            android:textAppearance="@style/TextAppearance.LeagueX.Title.Small" />

                        <TextView
                            android:id="@+id/useYoursTeam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                            android:textColor="@color/muted"
                            tools:text="Margalla Strikers" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/createNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_option_card"
                    android:divider="@drawable/gap_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:showDividers="middle">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/createNewRadio"
                        style="@style/Widget.LeagueX.RadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_glyph_circle"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_2"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/register_create"
                            android:textAppearance="@style/TextAppearance.LeagueX.Title.Small" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/register_create_body"
                            android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                            android:textColor="@color/muted" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.LeagueX.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/joinCode"
                    android:text="@string/register_join_code"
                    android:textAppearance="@style/TextAppearance.LeagueX.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LeagueX.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/joinCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        tools:text="IWC-5T9P" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.LeagueX.FieldHelp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_join_code_help" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:divider="@drawable/gap_12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:showDividers="middle">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_glyph_circle"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_emoji_events"
                    app:tint="@color/blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:divider="@drawable/gap_2"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/register_entering"
                        android:textAppearance="@style/TextAppearance.LeagueX.Label.Medium"
                        android:textColor="@color/muted" />

                    <TextView
                        android:id="@+id/competition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LeagueX.Title.Small"
                        tools:text="Islamabad Winter Cup" />

                    <TextView
                        android:id="@+id/competitionAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                        android:textColor="@color/muted"
                        tools:text="Knockout, starts Sat 6 Dec, organized by Kamran Shah" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 28 / Waiting for approval. -->
    <LinearLayout
        android:id="@+id/waiting"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@drawable/gap_24"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/page_margin"
        android:showDividers="middle"
        android:visibility="gone">

        <include
            android:id="@+id/empty"
            layout="@layout/include_empty_state" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:divider="@drawable/gap_12"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:showDividers="middle">

            <TextView
                android:id="@+id/waitingCrest"
                style="@style/Widget.LeagueX.Crest.M"
                tools:text="MAR" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:divider="@drawable/gap_2"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/waitingCompetition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LeagueX.Title.Small"
                    tools:text="Islamabad Winter Cup" />

                <TextView
                    android:id="@+id/waitingSent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                    android:textColor="@color/muted"
                    tools:text="Sent Sat 15 Nov" />
            </LinearLayout>

            <TextView
                style="@style/Widget.LeagueX.Status.Waiting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_waiting" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footer"
        style="@style/Widget.LeagueX.Footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send"
            style="@style/Widget.LeagueX.Button.Filled.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_send" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToTeam"
            style="@style/Widget.LeagueX.Button.Outlined.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_back"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
