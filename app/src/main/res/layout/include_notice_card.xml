<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 21 Announcements: one announcement as a card, its glyph, title and byline, then the start of its text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:divider="@drawable/gap_8"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    android:showDividers="middle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_12"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:showDividers="middle">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glyph_circle"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_campaign"
            app:tint="@color/blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_2"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LeagueX.Title.Small"
                tools:text="Matchday 5 kick-off times" />

            <TextView
                android:id="@+id/byline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                android:textColor="@color/muted"
                tools:text="Kamran Shah, Fri 14 Nov" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
        android:textColor="@color/muted"
        tools:text="All four matches are at F-9 Sports Arena on Sat 15 Nov. Arrive 20 minutes before kick-off." />
</LinearLayout>
