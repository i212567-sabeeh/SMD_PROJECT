<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 14 Match page / Before kick-off: one player in a line-up column, shirt number then name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/gap_8"
    android:orientation="horizontal"
    android:showDividers="middle">

    <TextView
        android:id="@+id/number"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
        android:textColor="@color/muted"
        tools:text="11" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
        tools:text="Muhammad Abdullah Qureshi" />
</LinearLayout>
