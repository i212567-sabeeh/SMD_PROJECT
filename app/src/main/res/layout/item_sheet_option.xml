<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 09 Switch league: a competition to show, a glyph, its name and your part in it, and a radio button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.LeagueX.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_glyph_circle"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_emoji_events"
        app:tint="@color/blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:divider="@drawable/gap_2"
        android:orientation="vertical"
        android:showDividers="middle">

        <TextView
            android:id="@+id/name"
            style="@style/Widget.LeagueX.Row.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Islamabad Futsal League" />

        <TextView
            android:id="@+id/meta"
            style="@style/Widget.LeagueX.Row.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="League, you play for Margalla Strikers" />
    </LinearLayout>

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/radio"
        style="@style/Widget.LeagueX.RadioButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
