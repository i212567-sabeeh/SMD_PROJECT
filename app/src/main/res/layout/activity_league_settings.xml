<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 44 League settings. Each setting with its current value, then End season and what it does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            style="@style/Widget.LeagueX.Content.Tight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:divider="@drawable/divider_line"
                android:orientation="vertical"
                android:showDividers="middle">

                <include
                    android:id="@+id/details"
                    layout="@layout/include_nav_row" />

                <include
                    android:id="@+id/rules"
                    layout="@layout/include_nav_row" />

                <include
                    android:id="@+id/banner"
                    layout="@layout/include_nav_row" />

                <include
                    android:id="@+id/joinCode"
                    layout="@layout/include_nav_row" />

                <include
                    android:id="@+id/organizers"
                    layout="@layout/include_nav_row" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:divider="@drawable/gap_8"
                android:orientation="vertical"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/endSeason"
                    style="@style/Widget.LeagueX.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_end_season"
                    app:icon="@drawable/ic_flag" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/settings_end_season_body"
                    android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                    android:textColor="@color/muted" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
