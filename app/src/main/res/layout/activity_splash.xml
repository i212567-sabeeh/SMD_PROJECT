<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 01 Splash. The wordmark, an orange bar and the tagline, centred on blue over the pitch markings. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue"
    android:clickable="true"
    android:focusable="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_pitch" />

    <!-- Blue behind the words, so the halfway line stops either side of them. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="@color/blue"
        android:divider="@drawable/gap_16"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp"
        android:showDividers="middle">

        <TextView
            style="@style/Widget.LeagueX.Anton.Splash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_wordmark" />

        <View
            android:layout_width="56dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_orange_bar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/start_tagline"
            android:textAppearance="@style/TextAppearance.LeagueX.Body.Large"
            android:textColor="@color/on_blue_muted" />
    </LinearLayout>
</FrameLayout>
