<!-- Figma: 14 Match page / Won on penalties, 50 Penalty shootout (ui.js kicksRow). A team's crest and code, its kicks
     (scored, missed or still to take) and its total. Bind it with IncludeKicksRowBinding.bind(code, kicks, total). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/crest"
        style="@style/Widget.LeagueX.Crest.S"
        tools:text="MAR" />

    <TextView
        android:id="@+id/code"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
        tools:text="MAR" />

    <!-- The binder adds one 32dp circle per kick. -->
    <LinearLayout
        android:id="@+id/kicks"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:divider="@drawable/gap_8"
        android:orientation="horizontal"
        android:showDividers="middle" />

    <TextView
        android:id="@+id/total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="@style/TextAppearance.LeagueX.Display.Small"
        tools:text="4" />
</LinearLayout>
