<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 38 Team requests. The Islamabad Winter Cup's entry requests to approve or decline, a way to add a team
     yourself, and the cup's join code to share. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <TextView
        android:id="@+id/about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
        android:textColor="@color/muted"
        tools:text="Islamabad Winter Cup, starts Sat 6 Dec" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            style="@style/Widget.LeagueX.Content.Tight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp">

            <LinearLayout
                android:id="@+id/requests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_16"
                android:orientation="vertical"
                android:showDividers="middle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addTeam"
                style="@style/Widget.LeagueX.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/requests_add"
                app:icon="@drawable/ic_add" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:divider="@drawable/gap_12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:divider="@drawable/gap_2"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/requests_code"
                        android:textAppearance="@style/TextAppearance.LeagueX.Label.Medium"
                        android:textColor="@color/muted" />

                    <TextView
                        android:id="@+id/code"
                        style="@style/Widget.LeagueX.Anton.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="IWC-5T9P" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/share"
                    style="@style/Widget.LeagueX.IconButton.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/published_share"
                    app:icon="@drawable/ic_share" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
