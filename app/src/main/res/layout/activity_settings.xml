<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 55 Settings. The account, notifications, offline storage and help, then Log out on its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            style="@style/Widget.LeagueX.Content.Tight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:divider="@drawable/divider_line"
                android:orientation="vertical"
                android:showDividers="middle">

                <include
                    android:id="@+id/account"
                    layout="@layout/include_nav_row" />

                <include
                    android:id="@+id/notifications"
                    layout="@layout/include_nav_row" />

                <include
                    android:id="@+id/offlineStorage"
                    layout="@layout/include_nav_row" />

                <include
                    android:id="@+id/help"
                    layout="@layout/include_nav_row" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/logOut"
                    layout="@layout/include_nav_row" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
