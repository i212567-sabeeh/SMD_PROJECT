<!-- Figma: Style kit, Offline banner; 08 Home / Offline, 25 Edit profile / Saved offline, 46 Record match / Offline, 52 Sync status (ui.js offlineBanner). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ink"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_cloud_off"
        app:tint="@color/on_blue" />

    <TextView
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:text="@string/kit_offline_banner"
        android:textAppearance="@style/TextAppearance.LeagueX.OfflineBanner" />
</LinearLayout>
