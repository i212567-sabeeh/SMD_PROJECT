<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 47 Add goal, a sheet over 46 Record match / Offline: the team, scorer and assist, own goal or penalty, and
     the minute, then Save goal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/head"
        layout="@layout/include_sheet_head" />

    <LinearLayout
        style="@style/Widget.LeagueX.SheetBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/team"
            layout="@layout/include_team_pick" />

        <include
            android:id="@+id/scorer"
            layout="@layout/include_player_pick" />

        <include
            android:id="@+id/assist"
            layout="@layout/include_player_pick" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                style="@style/Widget.LeagueX.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goal_own" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.LeagueX.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goal_penalty" />
        </com.google.android.material.chip.ChipGroup>

        <include
            android:id="@+id/minute"
            layout="@layout/include_minute_field" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            style="@style/Widget.LeagueX.Button.Filled.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/goal_save" />
    </LinearLayout>
</LinearLayout>
