<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 45 Line-ups. Pick who plays for each team, one tab per team, then Start match. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <TextView
        android:id="@+id/about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
        android:textColor="@color/muted"
        tools:text="MAR vs RAW, Sat 15 Nov, 7:00 pm" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        style="@style/Widget.LeagueX.Tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/squad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/paper"
            tools:itemCount="9"
            tools:listitem="@layout/item_player_row" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/footer"
        style="@style/Widget.LeagueX.Footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/picked"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                tools:text="8 players picked" />

            <TextView
                android:id="@+id/otherPicked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LeagueX.Body.Small"
                android:textColor="@color/muted"
                tools:text="Rawal Rovers: 7 picked" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start"
            style="@style/Widget.LeagueX.Button.Filled.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lineups_start"
            app:icon="@drawable/ic_play_arrow" />
    </LinearLayout>
</LinearLayout>
