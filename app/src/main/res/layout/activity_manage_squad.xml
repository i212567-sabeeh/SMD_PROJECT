<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 29 Manage squad (drawn with a player's menu open). The squad, each player with a call button and a menu,
     then the pending invites, and Add players pinned at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <include
        android:id="@+id/top"
        layout="@layout/include_top_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:textAppearance="@style/TextAppearance.LeagueX.Body.Medium"
                android:textColor="@color/muted"
                tools:text="Margalla Strikers, 9 players. Tap a player to change their number or position, or to remove them." />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/squad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/paper"
                tools:itemCount="9"
                tools:listitem="@layout/item_player_row" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="4dp"
                android:text="@string/squad_pending"
                android:textAppearance="@style/TextAppearance.LeagueX.Label.Large"
                android:textColor="@color/muted" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/paper"
                tools:itemCount="1"
                tools:listitem="@layout/item_player_row" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/footer"
        style="@style/Widget.LeagueX.Footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add"
            style="@style/Widget.LeagueX.Button.Filled.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/squad_add"
            app:icon="@drawable/ic_person_add" />
    </LinearLayout>
</LinearLayout>
