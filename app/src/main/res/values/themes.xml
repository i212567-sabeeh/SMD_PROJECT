<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- The design is light only, so the app doesn't follow the system dark mode. -->
    <style name="Theme.LeagueX" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>

        <!-- Archivo is the default type through text appearances, never a theme-level fontFamily: that would
             override the font of every text appearance a layout sets, as android:textColor would its colour. -->
        <item name="android:textViewStyle">@style/Widget.LeagueX.TextView</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.LeagueX.Material.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.LeagueX.Material.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.LeagueX.Material.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.LeagueX.Material.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.LeagueX.Material.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.LeagueX.Material.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.LeagueX.Material.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.LeagueX.Material.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.LeagueX.Material.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.LeagueX.Material.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.LeagueX.Material.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.LeagueX.Material.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.LeagueX.Material.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.LeagueX.Material.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.LeagueX.Material.LabelSmall</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>

        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@color/on_blue</item>
        <item name="colorPrimaryContainer">@color/tint</item>
        <item name="colorOnPrimaryContainer">@color/blue</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorSecondaryContainer">@color/tint</item>
        <item name="colorOnSecondaryContainer">@color/blue</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/page</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_blue</item>
        <item name="colorErrorContainer">@color/error_bg</item>
        <item name="colorOnErrorContainer">@color/error</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="scrimBackground">@color/scrim</item>
        <item name="snackbarStyle">@style/Widget.LeagueX.MaterialSnackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.LeagueX.MaterialSnackbar.Text</item>
    </style>

</resources>
